generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

// All money is stored as integer kobo (1 NGN = 100 kobo). Never floats.

model Customer {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique // normalised: 234XXXXXXXXXX
  createdAt DateTime @default(now())
  orders    Order[]
  regulars  RegularItem[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  category    String?
  imageUrl    String?
  priceKobo   Int
  unit        String      @default("kg") // kg, pack, piece
  packSizeG   Int? // grams per pack, if sold by pack
  stockQty    Int         @default(0)
  cartonKg    Int? // kg in one carton (10 chicken, 20 fish). Empty = not sold by the carton
  active      Boolean     @default(true)
  isAddOn     Boolean     @default(false) // ponmo, plantain and other extras
  costKobo    Int? // what one unit costs you, kobo. Empty = not set
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  regulars    RegularItem[]
  bundleItems BundleItem[]
  reviews     Review[]

  @@index([active, category])
}

model DeliveryZone {
  id           String  @id @default(cuid())
  name         String  @unique // e.g. "Lekki", "Ikeja"
  feeKobo      Int
  freeOverKobo Int? // free delivery above this subtotal, optional
  active       Boolean @default(true)
  isPickup     Boolean @default(false) // true = collect from the store
  minOrderKobo Int? // minimum food subtotal for this area
  deliveryDays String? // weekdays served, e.g. "2,6" = Tue and Sat (Sun=0). Empty = every day
  note         String? // shown to customers at checkout
  orders       Order[]
}

model DeliverySlot {
  id          String  @id @default(cuid())
  label       String // "9am - 12pm"
  startMinute Int // minutes from midnight, Lagos time
  endMinute   Int
  maxOrders   Int // capacity per day for this slot
  active      Boolean @default(true)
  orders      Order[]
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique // public, e.g. FG-9F3A...
  status     OrderStatus @default(PENDING_PAYMENT)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])

  contactName  String
  contactEmail String
  contactPhone String
  addressLine  String
  landmark     String?
  notes        String?

  zoneId       String
  zone         DeliveryZone @relation(fields: [zoneId], references: [id])
  slotId       String
  slot         DeliverySlot @relation(fields: [slotId], references: [id])
  deliveryDate String // YYYY-MM-DD, Lagos local date

  subtotalKobo    Int
  deliveryFeeKobo Int
  totalKobo       Int

  expiresAt DateTime // unpaid orders release stock after this
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]
  reviews  Review[]

  @@index([status, expiresAt])
  @@index([deliveryDate, slotId])
  @@index([customerId, createdAt])
  @@index([contactPhone])
  discountKobo           Int                  @default(0)
  promoDiscountKobo      Int                  @default(0)
  bundleDiscountKobo     Int                  @default(0)
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  refCode                String?
  trackingConsent        Boolean              @default(false)
  fbp                    String?
  fbc                    String?
  trackUa                String?
  trackIp                String?
  reminder1At            DateTime?
  reminder2At            DateTime?
  riderId                String?
  rider                  AdminUser?           @relation("OrderRider", fields: [riderId], references: [id])
  deliveredAt            DateTime?
  deliveryPhotoPath      String?
  coldChainOk            Boolean?
  deliveryNote           String?
  complaints             Complaint[]
  giftName               String?
  studentVerificationId  String?
  studentVerification    StudentVerification? @relation(fields: [studentVerificationId], references: [id])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  nameSnapshot  String
  unitPriceKobo Int
  quantity      Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String        @default("paystack")
  reference   String        @unique // our paymentReference
  providerRef String? // Paystack reference
  amountKobo  Int
  status      PaymentStatus @default(INITIATED)
  method      String?
  raw         Json?
  checkoutUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ---------- Admin dashboard ----------

enum AdminRole {
  OWNER
  MANAGER
  PACKER
  RIDER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         AdminRole
  passwordHash String
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  deliveries   Order[]   @relation("OrderRider")
}

// Single row (id = 1). Hours are minutes from midnight, Lagos time.
model StoreSettings {
  id                     Int      @id @default(1)
  openMinute             Int      @default(510) // 8:30 AM
  closeMinute            Int      @default(1260) // 9:00 PM
  lowStockThreshold      Int      @default(5)
  superBuyerMinOrders    Int      @default(5)
  superBuyerWindowDays   Int      @default(90)
  superBuyerMinSpendKobo Int      @default(0) // 0 = ignore spend rule
  loyalMinOrders         Int      @default(3)
  newCustomerDays        Int      @default(30)
  atRiskDays             Int      @default(45)
  lostDays               Int      @default(90)
  updatedAt              DateTime @updatedAt
  studentDiscountPercent Int      @default(0) // 0 = student discount is off
  studentDiscountMaxKobo Int? // optional cap per order, in kobo
  studentValidityDays    Int      @default(365)
  heroImageUrl           String?
  heroCaption            String?
  heroAlt                String?
}
// ---- FISH GUY FESTIVE CARTON DEALS ----

model FestivePromo {
  id               Int      @id @default(1)
  active           Boolean  @default(false)
  title            String   @default("Festive Carton Deals")
  startDate        String   @default("2026-12-15") // Lagos date, YYYY-MM-DD
  endDate          String   @default("2027-01-09") // last day included
  giftMinCartons   Int      @default(2)
  giftName         String?
  giftQty          Int      @default(0)
  bigMinCartons    Int      @default(5)
  rewardType       String   @default("NONE") // NONE | PERCENT | PER_CARTON | FREE_DELIVERY
  rewardValue      Int      @default(0) // percent, or kobo off per carton
  stackWithStudent Boolean  @default(false)
  popupEnabled     Boolean  @default(true)
  ribbonEnabled    Boolean  @default(true)
  ribbonText       String?
  popupImage       String?
  popupHeadline    String?
  popupMessage     String?
  popupButton      String?
  popupLink        String   @default("/festive")
  popupDelay       Int      @default(2)
  popupFrequency   String   @default("VISIT") // VISIT | DAY
  popupShowOffers  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// ---- FISH GUY SOUNDS: paste this block at the END of prisma/schema.prisma ----

enum MusicOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Artist {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  bio        String?
  imageUrl   String?
  bannerUrl  String?
  email      String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  tracks     Track[]
  announcements FanAnnouncement[]
  labelId    String?
  verifiedAt DateTime?
  label      Label?   @relation(fields: [labelId], references: [id], onDelete: SetNull)
  bankName      String?
  accountNumber String?
  accountName   String?
  splits        TrackSplit[]
  earnings      Earning[]
  payouts       Payout[]
}

model Track {
  id              String           @id @default(cuid())
  splits          TrackSplit[]
  isrc            String?          @unique
  artistId        String
  slug            String           @unique
  title           String
  genre           String
  mood            String?
  coverPath       String?
  previewPath     String?
  mp3Path         String?
  wavPath         String?
  priceKobo       Int              @default(0)
  durationSeconds Int
  isFreeToStream  Boolean          @default(false)
  isPublished     Boolean          @default(false)
  releasedAt      DateTime?
  createdAt       DateTime         @default(now())
  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Restrict)
  plays           MusicPlay[]
  orderItems      MusicOrderItem[]
  rightsConfirmedAt DateTime?
  rightsConfirmedBy String?
  copyrightOwner    String?
  copyrightYear     Int?
  takedownReports   TakedownReport[]

  payWhatYouWant  Boolean          @default(false)
  suggestedKobo   Int?
  releaseAt       DateTime?
  editionLimit    Int?

  isSuperfanOnly  Boolean          @default(false)
  listenEvents    ListenEvent[]

  @@index([isPublished, releasedAt])
  @@index([artistId])
  playlistTracks  PlaylistTrack[]
}

model MusicPlay {
  id           String   @id @default(cuid())
  trackId      String
  listenerHash String
  playDay      String
  playedAt     DateTime @default(now())
  country      String?
  region       String?
  city         String?
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, listenerHash, playDay])
  @@index([playedAt])
}

model MusicOrder {
  id               String           @id @default(cuid())
  buyerSessionHash String
  buyerEmail       String
  buyerName        String
  reference        String           @unique
  providerRef      String?
  checkoutUrl      String?
  idempotencyKey   String?          @unique
  amountKobo       Int
  status           MusicOrderStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  country          String?
  region           String?
  city             String?
  shareWithArtist  Boolean          @default(false)
  refundedAt       DateTime?
  refundNote       String?
  utmSource        String?
  utmCampaign      String?
  refCode          String?
  items            MusicOrderItem[]

  @@index([buyerSessionHash, status])
  @@index([buyerEmail])
}

model MusicOrderItem {
  id            String              @id @default(cuid())
  orderId       String
  trackId       String
  unitPriceKobo Int
  createdAt     DateTime            @default(now())
  order         MusicOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  track         Track               @relation(fields: [trackId], references: [id], onDelete: Restrict)
  editionNo     Int?
  downloadsFrom DateTime?
  earnings Earning[]
  downloadLinks MusicDownloadLink[]

  @@index([orderId])
  @@index([trackId])
}

model MusicDownloadLink {
  id          String         @id @default(cuid())
  orderItemId String
  tokenHash   String         @unique
  format      String
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  usedAt     DateTime?
  country    String?
  region     String?
  orderItem   MusicOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model ArtistApplication {
  id          String            @id @default(cuid())
  artistName  String
  contactName String
  email       String
  links       String
  message     String?
  status      ApplicationStatus @default(PENDING)
  reviewedAt  DateTime?
  rightsAcceptedAt DateTime?
  createdAt   DateTime          @default(now())
}


// ---- ARTIST DASHBOARD LOGIN ----

model RegularItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  quantity   Int
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model MessagingConsent {
  phone         String    @id
  marketing     Boolean   @default(false)
  source        String    @default("checkout")
  consentedAt   DateTime  @default(now())
  optedOutAt    DateTime?
  lastReorderAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model MessageLog {
  id        String   @id @default(cuid())
  channel   String
  to        String
  kind      String
  ref       String?
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

model Complaint {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           String
  message        String
  status         ComplaintStatus @default(OPEN)
  resolution     String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime        @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  adminName String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdSpend {
  id         String   @id @default(cuid())
  day        String // YYYY-MM-DD, Lagos date
  source     String
  amountKobo Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([day, source])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  sid       String
  type      String
  day       String
  source    String
  campaign  String?
  ref       String?
  createdAt DateTime @default(now())

  @@unique([sid, type, day])
  @@index([day, source])
  @@index([ref])
}

model TrackedLink {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  kind        String
  destination String
  artistId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LinkClick {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  priceKobo   Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  items       BundleItem[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  orderId     String
  rating      Int
  comment     String?
  displayName String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  moderatedAt DateTime?
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId, status])
}

model PayoutSetting {
  id             String   @id @default("default")
  artistBps      Int
  minPayoutKobo  Int      @default(500000)
  updatedAt      DateTime @updatedAt
}

model TrackSplit {
  id        String   @id @default(cuid())
  trackId   String
  artistId  String
  bps       Int
  role      String   @default("Collaborator")
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId])
  @@index([artistId])
}

model Payout {
  id            String    @id @default(cuid())
  artistId      String
  amountKobo    Int
  status        String    @default("REQUESTED")
  bankName      String
  accountNumber String
  accountName   String
  requestedAt   DateTime  @default(now())
  paidAt        DateTime?
  transferRef   String?
  note          String?
  artist        Artist    @relation(fields: [artistId], references: [id], onDelete: Restrict)
  earnings      Earning[]

  @@index([artistId])
  @@index([status])
}

model Earning {
  id          String          @id @default(cuid())
  orderItemId String
  artistId    String
  amountKobo  Int
  payoutId    String?
  createdAt   DateTime        @default(now())
  orderItem   MusicOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  artist      Artist          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  payout      Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, artistId])
  @@index([artistId, payoutId])
}

enum LabelStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

model Label {
  id              String         @id @default(cuid())
  name            String
  ownerEmail      String         @unique
  status          LabelStatus    @default(UNVERIFIED)
  emailVerifiedAt DateTime?
  approvedAt      DateTime?
  paidUntil       DateTime?
  rejectNote      String?
  createdAt       DateTime       @default(now())
  members         LabelMember[]
  artists         Artist[]
  payments        LabelPayment[]
}

model LabelMember {
  id        String   @id @default(cuid())
  labelId   String
  email     String   @unique
  role      String   @default("MANAGER")
  createdAt DateTime @default(now())
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@index([labelId])
}

model LabelPayment {
  id          String    @id @default(cuid())
  labelId     String
  reference   String    @unique
  amountKobo  Int
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  label       Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@index([labelId])
}

model ArtistCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// ---- COPYRIGHT REPORTS ----

model TakedownReport {
  id            String    @id @default(cuid())
  trackId       String?
  trackRef      String
  reporterName  String
  reporterEmail String
  ownership     String
  description   String
  proofUrl      String?
  signature     String
  status        String    @default("OPEN") // OPEN, ACTIONED, DISMISSED
  adminNote     String?
  handledAt     DateTime?
  createdAt     DateTime  @default(now())
  track         Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ---- LISTEN TRACKING AND FAN ANNOUNCEMENTS ----

model ListenEvent {
  id           String   @id @default(cuid())
  trackId      String
  listenerHash String
  day          String
  startedAt    DateTime @default(now())
  maxSeconds   Int      @default(0)
  completed    Boolean  @default(false)
  isFull       Boolean  @default(false)
  country      String?
  region       String?
  city         String?
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, startedAt])
  @@index([listenerHash, trackId, day])
}

model FanAnnouncement {
  id             String    @id @default(cuid())
  artistId       String
  audience       String    @default("ALL") // ALL or SUPERFANS
  subject        String
  body           String
  linkUrl        String?
  status         String    @default("PENDING") // PENDING, SENDING, SENT, REJECTED
  recipientCount Int       @default(0)
  reviewNote     String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  sentAt         DateTime?
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
  @@index([status])
}

model FanUnsubscribe {
  id        String   @id @default(cuid())
  email     String
  artistId  String
  createdAt DateTime @default(now())

  @@unique([email, artistId])
}

// ---- FISH GUY STUDENT DISCOUNT ----

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
  OTHER
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model Institution {
  id            String                @id @default(cuid())
  name          String                @unique
  type          InstitutionType
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  verifications StudentVerification[]
}

model StudentVerification {
  id               String        @id @default(cuid())
  reference        String        @unique
  fullName         String
  phone            String
  email            String
  institutionId    String?
  otherInstitution String?
  matricNumber     String
  idPath           String?
  status           StudentStatus @default(PENDING)
  rejectReason     String?
  approvedAt       DateTime?
  expiresAt        DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  institution      Institution?  @relation(fields: [institutionId], references: [id])
  orders           Order[]

  @@index([phone])
  @@index([status, createdAt])
}


// ---- FISH GUY ADS ----

enum AdPlacement {
  POPUP
  STICKER
  FEATURED_STRIP
  HERO_BANNER
  BAG_INSERT
}

enum AdStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum AdEventType {
  IMPRESSION
  CLICK
}

model AdPackage {
  id            String       @id @default(cuid())
  name          String
  placement     AdPlacement
  priceKobo     Int
  durationDays  Int
  maxConcurrent Int? // null = no limit
  description   String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  campaigns     AdCampaign[]
}

model AdCampaign {
  id           String      @id @default(cuid())
  reference    String      @unique
  packageId    String
  package      AdPackage   @relation(fields: [packageId], references: [id])
  packageName  String
  placement    AdPlacement
  priceKobo    Int
  durationDays Int
  artistName   String
  contactName  String
  phone        String
  email        String
  trackId      String?
  linkUrl      String?
  headline     String
  tagline      String?
  imagePath    String?
  startDate    String // YYYY-MM-DD, Lagos
  endDate      String
  status       AdStatus    @default(SUBMITTED)
  rejectReason String?
  reviewedAt   DateTime?
  paymentRef   String?     @unique
  providerRef  String?
  paidAt       DateTime?
  createdAt    DateTime    @default(now())
  events       AdEvent[]

  @@index([status, placement, startDate, endDate])
  @@index([phone])
}

model AdEvent {
  id         String      @id @default(cuid())
  campaignId String
  campaign   AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       AdEventType
  viewerHash String
  day        String // Lagos date: one impression and one click per viewer per day
  createdAt  DateTime    @default(now())

  @@unique([campaignId, type, viewerHash, day])
  @@index([campaignId, type])
}


// ---- FISH GUY PLAYLISTS (hand-made) ----

model Playlist {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  description    String?
  isPublished    Boolean         @default(false)
  isShopPlaylist Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tracks         PlaylistTrack[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}
